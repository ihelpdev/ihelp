generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  SUPER_ADMIN
}

enum KycStatus {
  PENDING
  VERIFIED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id                String            @id @default(uuid())
  name              String
  email             String            @unique
  role              Role              @default(CUSTOMER)
  kycStatus         KycStatus         @default(PENDING)
  profileCompleted  Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  profile           Profile?
  merchantProfile   MerchantProfile?
  jobsAsCustomer    Job[]             @relation("CustomerJobs")
  jobsAsMerchant    Job[]             @relation("MerchantJobs")
  wallets           Wallet[]
  subscriptions     Subscription[]
  merchantListings  MerchantListing[] @relation("MerchantListings")
  ratings           ServiceRating[]   @relation("CustomerRatings")
  referralCode      String?           @unique
  referredBy        String?
  sentMessages      Message[]         @relation("SentMessages")
  receivedMessages  Message[]         @relation("ReceivedMessages")
}

model Profile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender           Gender
  phone            String
  dob              DateTime
  location         String
  lat              Float?
  lng              Float?
  avatarUrl        String?
  nin              String?
  bvn              String?
  passportImageUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model MerchantProfile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  skills             String[]
  baseRate           Float    @default(0.0)
  acceptanceRate     Float    @default(100.0)
  internalAgentScore Float    @default(5.0)
  isAvailable        Boolean  @default(true)
}

enum JobStatus {
  PENDING
  ACCEPTED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CONFIRMED
  REJECTED
  DISPUTED
}

enum EscrowStatus {
  LOCKED
  RELEASED
}

model Job {
  id                  String       @id @default(uuid())
  customerId          String
  customer            User         @relation("CustomerJobs", fields: [customerId], references: [id])
  merchantId          String?
  merchant            User?        @relation("MerchantJobs", fields: [merchantId], references: [id])
  serviceId           String?
  serviceType         String?
  status              JobStatus    @default(PENDING)
  escrowStatus        EscrowStatus @default(LOCKED)
  amount              Float        @default(0.0)
  description         String?
  customerAddress     String?      // Stored delivery address
  customerLat         Float?       // Stored delivery lat
  customerLng         Float?       // Stored delivery lng
  customerNote        String?      // Additional note from the customer to the service provider
  customerNoteImages  String[]     @default([]) // Reference images attached by the customer
  frequency           String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  rating              ServiceRating?
  messages            Message[]
}

enum WalletType {
  EARNED
  DEPOSITED
}

model Wallet {
  id               String     @id @default(uuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  type             WalletType
  availableBalance Float      @default(0.0)
  escrowBalance    Float      @default(0.0)
  updatedAt        DateTime   @updatedAt
  transactions     WalletTransaction[]
}

enum SubFrequency {
  WEEKLY
  BIWEEKLY
}

model Subscription {
  id          String       @id @default(uuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  frequency   SubFrequency @default(WEEKLY)
  baseService String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model MerchantListing {
  id          String   @id @default(uuid())
  merchantId  String
  merchant    User     @relation("MerchantListings", fields: [merchantId], references: [id])
  name        String
  description String
  category    String   @default("General")
  tags        String[] @default([])
  coverImageUrl String?
  baseRateNgn Float
  unit        String   @default("hour")
  notes       String   @default("")
  details     Json     @default("{}")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ratings     ServiceRating[]
}

model ServiceRating {
  id                String          @id @default(uuid())
  jobId             String          @unique  // one rating per job
  job               Job             @relation(fields: [jobId], references: [id])
  customerId        String
  customer          User            @relation("CustomerRatings", fields: [customerId], references: [id])
  merchantListingId String?
  listing           MerchantListing? @relation(fields: [merchantListingId], references: [id])
  rating            Int             // 1-5
  comment           String?
  createdAt         DateTime        @default(now())
}

model SubscriptionPlan {
  id            String       @id @default(uuid())
  name          String
  description   String
  basePriceNgn  Float
  features      String[]
  imageUrl      String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AppSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model Message {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver  User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum TxType {
  CREDIT
  DEBIT
  ESCROW
}

enum TxStatus {
  COMPLETED
  PENDING
  FAILED
  LOCKED
}

model WalletTransaction {
  id          String   @id @default(uuid())
  walletId    String
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  type        TxType
  status      TxStatus
  amount      Float
  description String
  createdAt   DateTime @default(now())
}
